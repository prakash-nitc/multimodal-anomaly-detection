# Jupyter Notebook
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data (too large for git) — anchored to repo root so it does NOT match the
# da_zvad/datasets/ source package.
/data/
/datasets/
*.tar.gz
*.zip

# Model weights (too large for git)
weights/
checkpoints/
*.pth
*.pt
*.ckpt
*.bin

# Generated experiment outputs (regenerable — keep .gitkeep, ignore artifacts)
results/logs/*.json
results/tables/*.csv
results/figures/*.png
results/raw/
results/explanations/

# Reference PDFs supplied by the guide — copyrighted (Elsevier/IEEE/ACM),
# kept locally for study, never redistributed via this public repo.
SurveyPapersStudy/

# Editor / Office temp files
~$*

# Secrets
.env
*.key
